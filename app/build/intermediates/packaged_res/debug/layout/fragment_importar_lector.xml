<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        android:padding="14dp"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_toStartOf="@id/btnSesionesGuardadas"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sesiones del lector"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin conectar"
                android:textColor="#99ffffff"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSesionesGuardadas"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Sesiones guardadas"
            android:textColor="@color/blanco"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/blanco"/>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElegirLector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔌  Elegir lector"
            style="@style/BtnPrimary"/>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrá la app del lector (Data Link, etc.) antes de conectar: el lector atiende una sola conexión a la vez."
            android:textSize="12sp"
            android:textColor="@color/gris_texto"
            android:layout_marginTop="8dp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompartirRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄  Compartir registro de diagnóstico"
            android:visibility="gone"
            style="@style/BtnSecondary"
            android:layout_marginTop="6dp"/>

        <ProgressBar
            android:id="@+id/progreso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSesionesLector"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
