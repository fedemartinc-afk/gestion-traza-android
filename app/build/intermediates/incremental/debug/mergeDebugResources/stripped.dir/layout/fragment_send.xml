<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSend"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Topbar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_oscuro"
            android:padding="14dp"
            android:minHeight="56dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:contentDescription="Volver"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <!-- Logo a la derecha: deja el ancho restante libre para el texto -->
            <LinearLayout
                android:id="@+id/logoBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_logo"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BY LOOP AGTECH"
                    android:textColor="@color/verde_ok"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolbarLeft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/btnBack"
                android:layout_toStartOf="@id/logoBox"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lectura finalizada"
                    android:textColor="@color/blanco"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 caravanas válidas"
                    android:textColor="@color/blanco"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Botón enviar a usuario web -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarWeb"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enviar a usuario web"
                android:textSize="15sp"
                style="@style/BtnPrimary"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"/>

            <!-- Verificar Origen y Comparar vs TRI: mismo botón que en el perfil productor -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerificarOrigen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🔍  Verificar Origen"
                android:textSize="15sp"
                android:textStyle="bold"
                style="@style/BtnPrimary"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompararTri"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚖️  Comparar Vs. TRI"
                android:textSize="15sp"
                android:textStyle="bold"
                style="@style/BtnPrimary"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrdenarOrigen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🗂️  Ordenar por Origen"
                android:textSize="15sp"
                android:textStyle="bold"
                style="@style/BtnPrimary"
                android:layout_marginBottom="8dp"/>

            <!-- Resultados de verificación (inicialmente oculto) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVerificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvRenspaOrigen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tvVerifBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/verde_oscuro"
                        android:layout_marginBottom="8dp"/>

                    <!-- Contadores: entidades distintas y desglose de sexo -->
                    <LinearLayout
                        android:id="@+id/panelContadoresVerif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvEntidadesCountVerif"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="12sp"
                            android:textColor="#1a1a18"
                            android:gravity="center"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/gris_linea"/>

                        <TextView
                            android:id="@+id/tvSexoCountVerif"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:textSize="12sp"
                            android:textColor="#1a1a18"
                            android:gravity="center"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llResultadosVerif"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón enviar a DT-e (cierre SENASA) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarCierre"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Enviar a DT-e"
                android:textSize="15sp"
                style="@style/BtnDanger"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCierreNota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cierre: pide el DTe, usa el GPS actual y todas las caravanas. Requiere credenciales SENASA."
                android:textSize="11sp"
                android:textColor="@color/gris_texto"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Guarda la lectura en "Sesiones guardadas en dispositivo" -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearSesion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🗂  Crear sesión"
                android:textSize="15sp"
                style="@style/BtnPrimary"
                android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerSesiones"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🗂  Ver sesiones en este dispositivo"
            android:textSize="15sp"
            style="@style/BtnPrimary"
            android:layout_marginBottom="8dp"/>


            <!-- Progreso -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
