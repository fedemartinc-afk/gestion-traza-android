<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera del DTe -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/verde_oscuro"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDteNumero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/blanco"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvOrigenInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ccffffff"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvCantidadGrupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blanco"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#33ffffff"
                android:paddingHorizontal="9dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <!-- Sexo del grupo -->
        <TextView
            android:id="@+id/tvSexoGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/gris_texto"
            android:padding="10dp"/>

        <!-- Caravanas del grupo -->
        <TextView
            android:id="@+id/tvCaravanasGrupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="#1a1a18"
            android:paddingHorizontal="10dp"/>

        <TextView
            android:id="@+id/tvVerMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/verde_oscuro"
            android:paddingHorizontal="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"/>

        <!-- Enviar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarGrupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enviar a DT-e"
                style="@style/BtnPrimary"/>

            <ProgressBar
                android:id="@+id/progressGrupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvResultadoGrupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
