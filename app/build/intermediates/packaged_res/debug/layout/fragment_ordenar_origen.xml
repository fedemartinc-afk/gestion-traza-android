<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        android:padding="14dp"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnVolver"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:text="Ordenar por Origen"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvContadorBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="#99ffffff"
            android:textSize="12sp"/>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DTes -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Número de DTe"
                        android:textSize="11sp"
                        android:textColor="@color/gris_texto"
                        android:textAllCaps="true"
                        android:letterSpacing="0.06"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_marginEnd="8dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDte"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Escanear código de barras DT-e"
                                android:inputType="number"
                                android:fontFamily="monospace"
                                android:textSize="15sp"/>
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleTecladoDte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ABC"
                            android:textSize="11sp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="6dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEscanearDte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷"
                            android:textSize="15sp"
                            style="@style/BtnSecondary"
                            app:cornerRadius="8dp"
                            android:minWidth="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>

                    <!-- Filas de DTe adicionales -->
                    <LinearLayout
                        android:id="@+id/llExtraDtes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAgregarDte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Agregar otro DTe"
                        android:textSize="12sp"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textColor="@color/verde_oscuro"
                        android:layout_marginTop="4dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCargar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cargar DTes y Ordenar"
                        style="@style/BtnPrimary"
                        android:layout_marginTop="14dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEnviarWeb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enviar a usuario web"
                        style="@style/BtnSecondary"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvResultadoEnvio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ProgressBar
                android:id="@+id/progressCarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/gris_texto"
                android:visibility="gone"
                android:paddingVertical="4dp"/>

            <!-- Caravanas que no se pudieron consultar tras los reintentos automáticos -->
            <LinearLayout
                android:id="@+id/panelFallidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#fff4e5"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFallidasInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#8a5a00"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReintentarFallidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reintentar"
                    android:textSize="12sp"
                    style="@style/BtnSecondary"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"/>

            </LinearLayout>

            <!-- Contadores: entidades distintas y sexo (globales, todas las caravanas leídas) -->
            <LinearLayout
                android:id="@+id/panelContadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/blanco"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEntidadesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#1a1a18"
                    android:gravity="center"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/gris_linea"/>

                <TextView
                    android:id="@+id/tvSexoCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textSize="12sp"
                    android:textColor="#1a1a18"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Grupos por DTe -->
            <LinearLayout
                android:id="@+id/llGrupos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"/>

            <!-- Sin coincidencia -->
            <LinearLayout
                android:id="@+id/panelSinCoincidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSinCoincidenciaTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gris_texto"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvSinCoincidenciaLista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto"
                    android:background="@color/blanco"
                    android:padding="10dp"/>

            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresá los números de DT-e y presioná &quot;Cargar DTes y Ordenar&quot;"
                    android:textSize="13sp"
                    android:textColor="@color/gris_texto"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Volver al inicio: siempre disponible, se destaca cuando ya se envió (o falló)
         el resultado de todos los grupos con caravanas. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:textSize="14sp"
            style="@style/BtnSecondary"/>

    </LinearLayout>

</LinearLayout>
