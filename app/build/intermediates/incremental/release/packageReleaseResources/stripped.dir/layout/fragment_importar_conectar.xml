<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        android:padding="14dp"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"/>

        <TextView
            android:id="@+id/tvNombreLector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="10dp"
            android:text="Lector"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/tvNota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/gris_texto"
        android:background="@color/blanco"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElegirDispositivo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Elegir lector vinculado"
            style="@style/BtnPrimary"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/dotEstado"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_gray"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sin conectar"
            android:textSize="13sp"
            android:textColor="@color/gris_texto"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="8dp"
        android:background="@color/rojo_error_bg"
        android:padding="10dp"
        android:textColor="@color/rojo_error"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARAVANAS LEÍDAS"
        android:textSize="11sp"
        android:textColor="@color/gris_texto"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:padding="14dp"
        android:paddingBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/blanco"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvContenido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="#1a1a18"/>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescartar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Descartar"
            style="@style/BtnDanger"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarSesion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guardar sesión"
            style="@style/BtnPrimary"/>

    </LinearLayout>

</LinearLayout>
