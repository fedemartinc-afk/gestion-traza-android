<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro"
        android:padding="14dp"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Volver"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnVolver"
            android:layout_centerVertical="true"
            android:layout_marginStart="4dp"
            android:text="Estado para TRI"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvContadorBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:textColor="#99ffffff"
            android:textSize="12sp"/>

    </RelativeLayout>

    <!-- RENSPA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RENSPA del establecimiento"
            android:textSize="12sp"
            android:textColor="@color/gris_texto"/>

        <EditText
            android:id="@+id/etRenspa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="00.000.0.00000/00"
            android:inputType="text|textNoSuggestions"
            android:maxLength="20"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Verificar / Enviar a usuario web sin verificar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verificar caravanas"
            style="@style/BtnPrimary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar a usuario web"
            style="@style/BtnSecondary"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressVerif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="11sp"
        android:textColor="@color/gris_texto"
        android:visibility="gone"
        android:paddingBottom="6dp"/>

    <!-- Contadores: entidades distintas y sexo -->
    <LinearLayout
        android:id="@+id/panelContadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/blanco"
        android:paddingVertical="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvEntidadesCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#1a1a18"
            android:gravity="center"/>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/gris_linea"/>

        <TextView
            android:id="@+id/tvSexoCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textSize="12sp"
            android:textColor="#1a1a18"
            android:gravity="center"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerResultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Panel de envío -->
    <LinearLayout
        android:id="@+id/panelEnviar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:background="@color/blanco">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOTE:"
            android:textSize="12sp"
            android:textColor="@color/gris_texto"/>

        <EditText
            android:id="@+id/etNumeroLote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOTE :"
            android:inputType="text|textNoSuggestions"
            android:textSize="13sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/etLat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Latitud"
                android:inputType="numberDecimal|numberSigned"
                android:textSize="12sp"/>

            <EditText
                android:id="@+id/etLon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Longitud"
                android:layout_marginStart="4dp"
                android:inputType="numberDecimal|numberSigned"
                android:textSize="12sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS"
                android:layout_marginStart="4dp"
                style="@style/BtnSecondary"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnviarTRI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar TRI a SENASA"
            style="@style/BtnPrimary"/>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"/>

</LinearLayout>
