<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_oscuro"
            android:padding="14dp"
            android:minHeight="56dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Importar sesiones"
                    android:textColor="@color/blanco"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sesiones de lectores RFID por Bluetooth"
                    android:textColor="#99ffffff"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LECTOR"
            android:textSize="11sp"
            android:textColor="@color/gris_texto"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:padding="16dp"
            android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConectarBt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔌  Crear sesiones"
                    style="@style/BtnPrimary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sirve para el AS420 y la mayoría de los lectores EID con modo SPP — no hace falta elegir marca."
                    android:textSize="11sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSesionesLector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📥  Ver sesiones guardadas en el lector"
                    style="@style/BtnPrimary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lista las sesiones que tiene el lector y las trae a la app, sin usar la app del fabricante. Tru-Test XRS2 / SRS2 y Gallagher HR (este último sin probar todavía)."
                    android:textSize="11sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️  Tips de configuración por marca"
                    android:textSize="12sp"
                    android:textColor="@color/verde_ok"
                    android:textStyle="bold"
                    android:padding="4dp"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackground"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIN CONEXIÓN AL LECTOR"
            android:textSize="11sp"
            android:textColor="@color/gris_texto"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:padding="16dp"
            android:paddingBottom="4dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerSesiones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="🗂  Sesiones guardadas en dispositivo"
                    style="@style/BtnPrimary"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportarArchivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📂  Importar archivo"
                    style="@style/BtnSecondary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por si el lector solo transfiere por cable/USB o tarjeta a una PC. Acepta .txt, .csv o Excel (.xlsx)."
                    android:textSize="11sp"
                    android:textColor="@color/gris_texto"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <View android:layout_width="0dp" android:layout_height="32dp"/>

    </LinearLayout>
</ScrollView>
